# --- Acceso ---
# Contraseña única para entrar en la app
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la cookie de sesión (p. ej. `openssl rand -base64 32`)
SESSION_SECRET=

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave secreta nueva (formato sb_secret_...). Solo servidor: nunca la expongas al navegador.
SUPABASE_SECRET_KEY=sb_secret_

# --- IA (lib/ia.ts) ---
# Proveedor: "groq" (por defecto) o "anthropic"
IA_PROVEEDOR=groq
# Groq: clave en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo de texto y modelo con imágenes (por defecto, openai/gpt-oss-120b y qwen/qwen3.8-27b en Groq;
# con Anthropic, IA_MODELO sirve para los dos y por defecto es claude-opus-5-5)
IA_MODELO=
IA_MODELO_VISION=
# Solo si IA_PROVEEDOR=anthropic
ANTHROPIC_API_KEY=
